# 文件与数据目录
# 应用数据根目录。留空或不配置时，默认使用当前用户目录下的 .pet-comic
# Windows 示例：C:\Users\当前用户\.pet-comic
# PET_COMIC_DATA_DIR=

# 输入图片限制
# 单个漫画任务最多接收的图片数量
PET_COMIC_MAX_INPUT_IMAGES=12
# 单张图片大小上限，单位为 MB
PET_COMIC_MAX_IMAGE_SIZE_MB=10
# 同时执行的漫画任务数量
PET_COMIC_MAX_RUNNING_TASKS=1
# 单个任务最多同时发起的模型请求数量
PET_COMIC_MAX_MODEL_REQUESTS_PER_TASK=3
# 模型请求超时时间，单位为秒
PET_COMIC_REQUEST_TIMEOUT_SECONDS=180
# SSE 任务事件流心跳间隔，单位为秒
PET_COMIC_SSE_HEARTBEAT_SECONDS=15

# 图片生成与合成
# 单格漫画的生成尺寸
PET_COMIC_PANEL_SIZE=1024x1024
# 图片生成质量，可使用供应商支持的值
PET_COMIC_IMAGE_QUALITY=auto
# 生成图片的文件格式
PET_COMIC_OUTPUT_FORMAT=png
# 九宫格单元格之间的间距，单位为像素
PET_COMIC_GRID_GAP=12

# 日志
# 日志级别，例如 DEBUG、INFO、WARNING、ERROR
PET_COMIC_LOG_LEVEL=INFO
# 是否记录模型原始响应，仅建议调试时开启
PET_COMIC_DEBUG_RAW_RESPONSES=false
